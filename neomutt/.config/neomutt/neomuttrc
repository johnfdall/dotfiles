########################################
# Identity
########################################

set realname = "John Fredrik Dall"

# Keyed by long key ID, not by address: the sending address (johnfdall@pm.me)
# is not a uid on this key, so looking it up by that address finds nothing.
set pgp_default_key = "7EAB26A06D9DC550"
set pgp_use_gpg_agent
set pgp_timeout = 1800

########################################
# Account
########################################

# NOTE: paths here are spelled out as ~/.config rather than $XDG_CONFIG_HOME.
# XDG_CONFIG_HOME/XDG_CACHE_HOME are not exported on this machine, and neomutt
# expands an unset env var to the empty string -- which would silently turn
# every path below into a bare relative one.

# Credentials are pulled from `pass` at parse time; see accounts/proton.rc.
source "~/.config/neomutt/accounts/proton.rc"

# Every address this account receives on. `alternates` is what makes neomutt
# recognise a message as addressed to you -- it drives the "to me" index flags
# and stops group-reply from CC'ing you back.
alternates '^johnfdall@pm\.me$' '^john\.fredrik\.dall@protonmail\.com$'

# Reply from whichever of those addresses the message was sent to, rather than
# always from $from. Without this, mail to one address gets answered from the
# other, which looks like a different person to the recipient.
set reverse_name
set reverse_realname

# Envelope sender follows the From header (including reverse_name's choice);
# pinning envelope_from_address here would override that and make the envelope
# disagree with the visible From.
set use_envelope_from = yes

########################################
# Mailboxes and behavior
########################################

# Don't move read mail out of the IMAP INBOX. ask-yes still prompts on every
# exit ("Move N read messages to ~/mbox?") and defaults to yes, which would
# drain the INBOX into a local mbox file. Archiving is a server-side job.
set move = no

# Confirm deletions
set delete = ask-yes

# Check mail every 15s, and IMAP keepalive
set mail_check = 15
set timeout    = 15

# Read threads newest -> oldest
set sort = reverse-threads

# Don't wait on "changing folder" etc.
set sleep_time = 0

########################################
# UI / formats
########################################

set status_format = "%f"
set date_format   = "%m%d"
set index_format  = "%Z %D %-15.15n %s"

# Aliases file (contacts)
set alias_file = "~/.config/neomutt/alias"
source "~/.config/neomutt/alias"

set signature = "~/.config/neomutt/signature"

# Sidebar: same shape as nvim-tree; toggled with `B` (see bindings.rc)
set sidebar_visible = yes
set sidebar_width = 24
set sidebar_short_path = yes
set sidebar_folder_indent = yes
set sidebar_indent_string = "  "
set sidebar_format = "%D%* %?N?%N/?%S"
set sidebar_divider_char = "│"

# Prefer plain text to HTML; auto-view HTML when needed
alternative_order text/plain text/html
auto_view text/html
set mailcap_path = "~/.config/neomutt/mailcap"
bind attach <return> view-mailcap

########################################
# Pager / display
########################################

ignore *
unignore From Message-ID Date To Cc Bcc Subject

set pager_stop        # don't show next message automatically
unset markers         # don't show '+' wrap markers

########################################
# Editor / compose
########################################

set editor = "nvim"
set indent_string = ">"
set reflow_wrap = 80
set reflow_text
unset reflow_space_quotes

########################################
# IMAP / TLS
########################################

unset imap_passive
set imap_check_subscribed
set imap_keepalive = 900

set ssl_verify_dates
set ssl_verify_host

# Proton Bridge serves a self-signed cert; trust it explicitly rather than
# answering the accept-certificate prompt on every cold start.
set certificate_file = "~/.cache/neomutt/certificates"
set ssl_ca_certificates_file = "~/.config/protonmail/bridge-v3/cert.pem"

source "~/.config/neomutt/bindings.rc"
source "~/.config/neomutt/colors.rc"

# Optional per-machine overrides, sourced last so they win. Gitignored: this
# is where anything machine-specific belongs -- most obviously pgp_default_key,
# since a key generated locally differs on every box.
#
# Sourced via a command (note the trailing `|`) rather than a plain path,
# because neomutt errors on a missing file and there is no conditional source.
# `cat` of a nonexistent file simply yields nothing.
source "cat ~/.config/neomutt/local.rc 2>/dev/null |"
