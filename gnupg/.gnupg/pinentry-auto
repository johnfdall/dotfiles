#!/bin/bash
# Pick a pinentry backend that the person actually being asked can SEE.
#
# gpg-agent is a long-lived daemon: it spawns pinentry with its own
# environment, not the calling client's, so $SSH_CONNECTION is invisible here
# and can't be used to detect an SSH session. What the agent *does* forward is
# the client's display, as an explicit `--display` argument. So: display
# argument present -> there's a graphical session to draw on; absent -> we're
# being asked from a plain TTY (an SSH login, or a systemd unit) and must
# prompt in the terminal instead.
#
# This matters because the alternative is silent: a GUI prompt raised for an
# SSH user appears on the physical machine's screen, is never answered, and
# times out. ProtonMail Bridge counts such a timeout as a vault failure and
# resets its vault -- logging the account out -- after three of them.
#
# Backends are discovered rather than hardcoded, so this works on Arch
# (pinentry-gnome3, /usr/bin) and macOS (pinentry-mac, /opt/homebrew/bin)
# without per-machine edits.

graphical=(pinentry-gnome3 pinentry-mac pinentry-qt pinentry-gtk-2)
terminal=(pinentry-curses pinentry-tty)

want=("${terminal[@]}")
for arg in "$@"; do
	case "$arg" in
	--display | --display=*)
		want=("${graphical[@]}")
		break
		;;
	esac
done

for backend in "${want[@]}"; do
	if path=$(command -v "$backend" 2>/dev/null); then
		exec "$path" "$@"
	fi
done

# Nothing from the preferred family is installed. Fall back to anything at all
# rather than leaving gpg with no pinentry, which fails opaquely.
for backend in "${graphical[@]}" "${terminal[@]}" pinentry; do
	if path=$(command -v "$backend" 2>/dev/null); then
		exec "$path" "$@"
	fi
done

echo "pinentry-auto: no pinentry backend found in PATH" >&2
exit 1
